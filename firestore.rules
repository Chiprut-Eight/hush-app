rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // ========================================
    // HELPER: Check if user is admin
    // ========================================
    function isAdmin() {
      return request.auth != null && (
        request.auth.uid == 'A30Br3OakdXF5BnfQFu5pryOsgy2' ||
        ('admin' in request.auth.token && request.auth.token.admin == true) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('isAdmin', false) == true)
      );
    }
    
    // ========================================
    // USERS — Public read, owner-only write for sensitive fields
    // ========================================
    match /users/{userId} {
      // Any authenticated user can read profiles
      allow read: if request.auth != null;
      
      // Only the owner can write their own profile
      // Exception: followerIds may be updated by others (follow system fan-out)
      // Exception: admins can update any user (for ghost mode, tier resets, etc.)
      allow write: if request.auth != null && (
        request.auth.uid == userId ||
        // Allow other users to ONLY modify followerIds (for follow fan-out)
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['followerIds'])) ||
        // Allow admins to update any user
        isAdmin()
      );
      
      match /notifications/{notifId} {
        // Only the owner can read their notifications; admins can write (for ghost mode alerts)
        allow read: if request.auth != null && request.auth.uid == userId;
        allow write: if request.auth != null && (request.auth.uid == userId || isAdmin());
      }
    }
    
    // ========================================
    // SECRETS — Metadata readable, content PROTECTED
    // ========================================
    match /secrets/{secretId} {
      // Any authenticated user can read secret metadata
      allow read: if request.auth != null;
      
      // Creation: any authenticated user
      allow create: if request.auth != null;
      
      // Updates: allow interaction fields only (likes, dislikes, views, etc.)
      // Full content/admin changes go through Cloud Functions
      allow update: if request.auth != null && (
        isAdmin() ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'likes', 'dislikes', 'views', 'viewedBy',
          'saveCount', 'commentCount', 'reportCount',
          'unlockedBy', 'isHidden'
        ])
      );
      
      // Only creator or admin can delete
      allow delete: if request.auth != null && (resource.data.creatorId == request.auth.uid || isAdmin());
      
      // PROTECTED CONTENT — Admin can read/write for moderation; Cloud Functions handle user reveals
      match /content/{contentId} {
        allow read: if isAdmin();
        allow write: if isAdmin();
      }
      
      // Unlock attempts — read by anyone, write only via Cloud Functions
      match /unlockAttempts/{attemptId} {
        allow read: if request.auth != null;
        allow write: if false;
      }
      
      // Comments — CRUD with ownership checks
      match /comments/{commentId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null;
        allow update, delete: if request.auth != null && resource.data.userId == request.auth.uid;
      }
    }
    
    // ========================================
    // REPORTS — Any user can create; admin can read & update
    // ========================================
    match /reports/{reportId} {
      allow create: if request.auth != null;
      allow read, update, delete: if isAdmin();
    }
    
    // ========================================
    // APPEALS — Any user can create; admin can read & update
    // ========================================
    match /appeals/{appealId} {
      allow create: if request.auth != null;
      allow read, update, delete: if isAdmin();
    }
  }
}
