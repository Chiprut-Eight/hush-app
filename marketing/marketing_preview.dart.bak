          NotificationsButton(),
          Padding(
            padding: EdgeInsets.symmetric(horizontal: 12.0),
            child: HushIcon(HushIcons.refresh, size: 20, color: Colors.white),
          ),
        ],
      ),
      body: _buildBackgroundContainer(
        child: Stack(
          children: [
            FlutterMap(
              options: const MapOptions(
                initialCenter: LatLng(32.0853, 34.7818),
                initialZoom: 16.5,
              ),
              children: [
                TileLayer(
                  urlTemplate: 'https://tile.openstreetmap.org/{z}/{x}/{y}.png',
                  userAgentPackageName: 'com.chiprut.hushhh',
                  tileBuilder: (context, tileWidget, tile) {
                    return ColorFiltered(
                      colorFilter: const ColorFilter.matrix([
                        -0.8,    0,    0, 0, 150,  // Red
                           0, -0.8,    0, 0, 150,  // Green 
                           0,    0, -0.8, 0, 170,  // Blue (slightly higher for cool tint)
                           0,    0,    0, 1,   0,  // Alpha
                      ]),
                      child: tileWidget,
                    );
                  },
                ),
                CircleLayer(
                  circles: [
                    CircleMarker(
                      point: const LatLng(32.0853, 34.7818),
                      radius: 80,
                      color: HushColors.textAccent.withValues(alpha: 0.15),
                      borderColor: HushColors.textAccent.withValues(alpha: 0.5),
                      borderStrokeWidth: 2,
                    ),
                    CircleMarker(
                      point: const LatLng(32.0853, 34.7818),
                      radius: 12,
                      color: HushColors.textAccent,
                      borderColor: Colors.white,
                      borderStrokeWidth: 3,
                    ),
                  ],
