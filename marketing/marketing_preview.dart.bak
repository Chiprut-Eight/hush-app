                  markers: [
                    Marker(
                      point: const LatLng(32.0865, 34.7825),
                      width: 150,
                      height: 50,
                      child: _buildMapPin(isHe ? 'Dan • 45m' : 'Dan • 45m', '#67E8F9', Icons.mic),
