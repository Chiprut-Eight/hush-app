                      point: const LatLng(32.0842, 34.7810),
                      width: 160,
                      height: 50,
                      child: _buildMapPin(isHe ? 'Tier 7 • 120m' : 'Tier 7 • 120m', '#FFD700', Icons.star),
                    ),
                    Marker(
                      point: const LatLng(32.0875, 34.7835),
                      width: 190,
                      height: 50,
                      child: _buildMapPin(isHe ? 'קבוצתי (2/3) • 180m' : 'Group (2/3) • 180m', '#FF69B4', Icons.group),
                    ),
                  ],
                ),
              ],
            ),
            // Floating Filter Chips
            Positioned(
              top: 12,
              right: 16,
              child: Row(
                mainAxisSize: MainAxisSize.min,
                children: [
                  _buildFilterChip(isHe ? 'הכל' : 'All', true),
                  const SizedBox(width: 8),
                  _buildFilterChip(isHe ? 'קוליים' : 'Audio', false),
                  const SizedBox(width: 8),
