                            crossAxisAlignment: CrossAxisAlignment.start,
                            children: [
                              const Text('DanLevi', style: TextStyle(color: Colors.white, fontSize: 12, fontWeight: FontWeight.bold)),
                              Text(isHe ? 'הקלטה מדהימה! הסאונד כאן ממש צלול 🔥' : 'Incredible recording! The acoustic reverb is pure 🔥', style: const TextStyle(color: Colors.white70, fontSize: 12)),
                            ],
                          ),
                        ),
                      ],
                    ),
                  ],
                ),
              ),
            ],
          ),
        ),
      ),
      bottomNavigationBar: _buildAppShellBottomNav(0, isHe),
    );
  }

  // --- SCREEN 5: CREATE / PLANT ---
  Widget _buildCreateScreen(bool isHe) {
    return Scaffold(
      drawer: const HushDrawer(),
      body: _buildBackgroundContainer(
        child: const CreateScreen(),
      ),
      bottomNavigationBar: _buildAppShellBottomNav(2, isHe),
    );
  }

  // --- SCREEN 6: GROUP HUSHHH ---
  Widget _buildGroupSecretScreen(bool isHe) {
    final groupSecret = Secret(
      id: 'mock_group_sec',
      creatorId: 'mock_c3',
      creatorName: 'SoundSeeker',
      creatorTierLevel: 5,
      creatorTierColor: '#A855F7',
      type: 'voice',
      isGroup: true,
      requiredUsers: 3,
      audioDuration: 52,
      likes: 65,
      commentCount: 11,
      lat: 32.0853,
      lng: 34.7818,
    );

    return Scaffold(
      appBar: AppBar(
        title: Text(isHe ? 'Hushhh קבוצתי' : 'Group Hushhh', style: const TextStyle(fontWeight: FontWeight.bold, color: Colors.white)),
        backgroundColor: Colors.transparent,
        elevation: 0,
      ),
      body: _buildBackgroundContainer(
        child: SingleChildScrollView(
          padding: const EdgeInsets.all(16.0),
          child: Column(
            children: [
              SecretCard(secret: groupSecret),
              const SizedBox(height: 24),
              Container(
                padding: const EdgeInsets.all(24),
                decoration: BoxDecoration(
                  color: const Color(0xFF1E293B).withValues(alpha: 0.7),
                  borderRadius: BorderRadius.circular(24),
                  border: Border.all(color: HushColors.tierPurple.withValues(alpha: 0.5), width: 1.5),
                  boxShadow: [
                    BoxShadow(
                      color: HushColors.tierPurple.withValues(alpha: 0.2),
                      blurRadius: 20,
                      spreadRadius: 2,
                    ),
                  ],
                ),
                child: Column(
                  children: [
                    const CircleAvatar(
                      radius: 36,
                      backgroundColor: HushColors.tierPurple,
                      child: Icon(Icons.groups, size: 40, color: Colors.white),
                    ),
                    const SizedBox(height: 16),
                    Text(
                      isHe ? 'נדרשים 3 אנשים יחד במקום' : '3 people required together here',
                      style: const TextStyle(fontWeight: FontWeight.bold, fontSize: 18, color: Colors.white),
                      textAlign: TextAlign.center,
                    ),
                    const SizedBox(height: 6),
                    Text(
                      isHe ? '2 מתוך 3 כבר כאן!' : '2 of 3 already here!',
                      style: const TextStyle(fontWeight: FontWeight.bold, fontSize: 15, color: HushColors.textAccent),
                    ),
                    const SizedBox(height: 20),
                    Row(
                      mainAxisAlignment: MainAxisAlignment.center,
                      children: [
                        _buildUserParticipant(Icons.person, true, 'User 1'),
                        const SizedBox(width: 16),
                        _buildUserParticipant(Icons.person, true, 'User 2'),
                        const SizedBox(width: 16),
                        _buildUserParticipant(Icons.help_outline, false, isHe ? 'מחפש...' : 'Searching...'),
                      ],
                    ),
                    const SizedBox(height: 24),
                    SizedBox(
                      width: double.infinity,
                      height: 48,
                      child: ElevatedButton.icon(
                        onPressed: () {},
                        icon: const Icon(Icons.lock_open, color: Colors.white),
                        label: Text(
                          isHe ? 'הצטרף לפתיחה משותפת' : 'Join Group Unlock',
                          style: const TextStyle(fontWeight: FontWeight.bold, color: Colors.white, fontSize: 15),
                        ),
                        style: ElevatedButton.styleFrom(
                          backgroundColor: HushColors.tierPurple,
                          shape: RoundedRectangleBorder(borderRadius: BorderRadius.circular(16)),
                        ),
                      ),
                    ),
                  ],
                ),
              ),
            ],
          ),
        ),
      ),
      bottomNavigationBar: _buildAppShellBottomNav(0, isHe),
    );
  }

  Widget _buildUserParticipant(IconData icon, bool joined, String label) {
    return Column(
      children: [
        CircleAvatar(
          radius: 24,
          backgroundColor: joined ? HushColors.tierPurple.withValues(alpha: 0.25) : Colors.white12,
          child: Icon(icon, color: joined ? HushColors.tierPurple : Colors.white38),
        ),
        const SizedBox(height: 6),
        Text(label, style: TextStyle(fontSize: 11, color: joined ? Colors.white : Colors.white38)),
      ],
    );
  }

  // --- SCREEN 7 & 10: PROFILE & VAULT ---
  Widget _buildProfileScreen(bool isHe, {required bool showSaved}) {
    final user = MockAuthProvider()._mockUser;
    final tierColor = HushColors.tierColor(user.tierLevel);

    return Scaffold(
      drawer: const HushDrawer(),
      appBar: AppBar(
        title: Text(isHe ? 'פרופיל' : 'Profile', style: const TextStyle(fontWeight: FontWeight.bold, color: Colors.white)),
        backgroundColor: Colors.transparent,
        elevation: 0,
        actions: const [
          NotificationsButton(),
        ],
      ),
      body: _buildBackgroundContainer(
        child: ListView(
          padding: const EdgeInsets.symmetric(vertical: 16),
          children: [
            // User avatar and name (Authentic from lib/screens/profile_screen.dart)
            Center(
              child: Column(
                children: [
                  CircleAvatar(
                    radius: 48,
                    backgroundColor: HushColors.bgCard,
                    child: const HushIcon(HushIcons.person, size: 48, color: HushColors.textMuted),
                  ),
                  const SizedBox(height: 12),
                  Text(
                    user.displayName ?? 'SonicMaster',
                    style: const TextStyle(fontSize: 22, fontWeight: FontWeight.bold, color: Colors.white),
                  ),
                  const SizedBox(height: 8),
                  Container(
                    padding: const EdgeInsets.symmetric(horizontal: 12, vertical: 4),
                    decoration: BoxDecoration(
                      color: tierColor.withValues(alpha: 0.2),
                      borderRadius: BorderRadius.circular(12),
                      border: Border.all(
                        color: tierColor.withValues(alpha: 0.5),
                      ),
                    ),
                    child: Text(
                      isHe ? 'דרגה 5 (מומחה)' : 'Tier 5 (Expert)',
                      style: TextStyle(
                        color: tierColor,
                        fontWeight: FontWeight.w600,
                      ),
                    ),
                  ),
                ],
              ),
            ),

            const SizedBox(height: 32),

            // Stats cards (Authentic _buildStatRow from profile_screen.dart)
            Padding(
              padding: const EdgeInsets.symmetric(horizontal: 16),
              child: Column(
                children: [
                  _buildStatRow(isHe ? 'Hushhh שפורסמו' : 'Published Hushhh', '14'),
                  _buildStatRow(isHe ? 'עוקבים' : 'Followers', '342'),
                ],
              ),
            ),

            const SizedBox(height: 32),

            // Tab Switcher for Secrets (CupertinoSlidingSegmentedControl)
            Padding(
              padding: const EdgeInsets.symmetric(horizontal: 16),
              child: CupertinoSlidingSegmentedControl<int>(
                backgroundColor: HushColors.bgCard,
                thumbColor: const Color(0xFF1E2638),
                groupValue: showSaved ? 1 : 0,
                padding: const EdgeInsets.all(4),
                children: {
                  0: Padding(
                    padding: const EdgeInsets.symmetric(vertical: 12),
                    child: Text(
                      isHe ? 'ה-Hushhh שלי' : 'My Hushhh',
                      style: TextStyle(
                        color: !showSaved ? Colors.white : HushColors.textMuted,
                        fontWeight: FontWeight.w600,
                      ),
                    ),
                  ),
                  1: Padding(
                    padding: const EdgeInsets.symmetric(vertical: 12),
                    child: Text(
                      isHe ? 'Hushhh שנשמרו (2)' : 'Saved Hushhh (2)',
                      style: TextStyle(
                        color: showSaved ? Colors.white : HushColors.textMuted,
                        fontWeight: FontWeight.w600,
                      ),
                    ),
                  ),
                },
                onValueChanged: (_) {},
              ),
            ),
            const SizedBox(height: 16),

            // Secrets list
            if (showSaved) ...[
              SecretCard(
                secret: Secret(
                  id: 'saved_1',
                  creatorId: 'c_sound',
                  creatorName: 'SoundSeeker',
                  creatorTierLevel: 4,
                  creatorTierColor: '#EC4899',
                  type: 'voice',
                  audioDuration: 38,
                  likes: 56,
                  commentCount: 9,
                  lat: 32.0853,
                  lng: 34.7818,
                ),
              ),
              SecretCard(
                secret: Secret(
                  id: 'saved_2',
                  creatorId: 'c_maya',
                  creatorName: 'MayaCohen',
                  creatorTierLevel: 2,
                  creatorTierColor: '#A855F7',
                  type: 'text',
                  textContent: isHe
                      ? 'הבריזה כאן בערב מושלמת. מומלץ לעצור להקשיב לשקט.'
                      : 'The evening breeze here is magical. Perfect spot to listen to the silence.',
                  likes: 82,
                  commentCount: 5,
                  lat: 32.0860,
                  lng: 34.7825,
                ),
              ),
            ] else ...[
              SecretCard(
                secret: Secret(
                  id: 'my_1',
                  creatorId: user.uid,
                  creatorName: user.displayName,
                  creatorTierLevel: 5,
                  creatorTierColor: '#67E8F9',
                  type: 'voice',
                  audioDuration: 42,
                  likes: 74,
                  commentCount: 12,
                  lat: 32.0853,
                  lng: 34.7818,
                ),
              ),
              SecretCard(
                secret: Secret(
                  id: 'my_2',
                  creatorId: user.uid,
                  creatorName: user.displayName,
                  creatorTierLevel: 5,
                  creatorTierColor: '#67E8F9',
                  type: 'text',
                  textContent: isHe
                      ? 'הקלטתי הד מיוחד בין הבניינים. חפשו את הנקודה המדויקת!'
                      : 'Recorded a special echo between the buildings. Find the exact sweet spot!',
                  likes: 49,
                  commentCount: 7,
                  lat: 32.0845,
                  lng: 34.7810,
                ),
              ),
            ],

            const SizedBox(height: 24),
            Center(
              child: Text(
                'HUSH v1.0.0',
                style: TextStyle(color: Colors.white.withValues(alpha: 0.2), fontSize: 12),
              ),
            ),
            const SizedBox(height: 40),
          ],
        ),
      ),
      bottomNavigationBar: _buildAppShellBottomNav(4, isHe),
    );
  }

  Widget _buildStatRow(String label, String value) {
    return Padding(
      padding: const EdgeInsets.symmetric(vertical: 6),
      child: Container(
        padding: const EdgeInsets.symmetric(horizontal: 16, vertical: 14),
        decoration: BoxDecoration(
          color: HushColors.bgCard,
          borderRadius: BorderRadius.circular(12),
          border: Border.all(color: HushColors.borderSubtle),
        ),
        child: Row(
          mainAxisAlignment: MainAxisAlignment.spaceBetween,
          children: [
            Text(label, style: const TextStyle(color: HushColors.textSecondary, fontSize: 14)),
            Text(
              value,
              style: const TextStyle(
                fontWeight: FontWeight.bold,
                color: HushColors.textPrimary,
                fontSize: 18,
              ),
            ),
          ],
        ),
      ),
    );
  }

  // --- SCREEN 8: FOLLOWING FEED ---
  Widget _buildFollowingScreen(bool isHe) {
    final creators = [
      {'name': 'MayaCohen', 'color': '#A855F7', 'tier': 'Tier 2'},
      {'name': 'DanLevi', 'color': '#67E8F9', 'tier': 'Tier 4'},
      {'name': 'AcousticNomad', 'color': '#FFD700', 'tier': 'Tier 7'},
      {'name': 'SoundSeeker', 'color': '#EC4899', 'tier': 'Tier 3'},
    ];

    return Scaffold(
      drawer: const HushDrawer(),
      appBar: AppBar(
        title: Text(isHe ? 'יוצרים במעקב' : 'Following', style: const TextStyle(fontWeight: FontWeight.bold, color: Colors.white)),
        backgroundColor: Colors.transparent,
        elevation: 0,
      ),
      body: _buildBackgroundContainer(
        child: ListView(
          padding: const EdgeInsets.all(16),
          children: [
            // Search field
            TextField(
              decoration: InputDecoration(
                hintText: isHe ? 'חפש יוצרים או Hushhh במעקב...' : 'Search creators or followed Hushhh...',
                prefixIcon: const Icon(Icons.search, color: HushColors.textSecondary),
                filled: true,
                fillColor: const Color(0xFF1E293B).withValues(alpha: 0.8),
                border: OutlineInputBorder(borderRadius: BorderRadius.circular(16), borderSide: BorderSide.none),
              ),
            ),
            const SizedBox(height: 20),
            // Horizontal creator avatar row
            SizedBox(
              height: 100,
              child: ListView.builder(
                scrollDirection: Axis.horizontal,
                itemCount: creators.length,
                itemBuilder: (context, i) {
                  final c = creators[i];
                  final col = Color(int.parse(c['color']!.replaceAll('#', '0xFF')));
                  return Container(
                    margin: const EdgeInsets.only(right: 16),
                    child: Column(
                      children: [
                        CircleAvatar(
                          radius: 28,
                          backgroundColor: col,
                          child: CircleAvatar(
                            radius: 25,
                            backgroundColor: HushColors.bgPrimary,
                            child: Text(c['name']![0], style: TextStyle(color: col, fontWeight: FontWeight.bold, fontSize: 18)),
                          ),
                        ),
                        const SizedBox(height: 6),
                        Text(c['name']!, style: const TextStyle(color: Colors.white, fontSize: 12, fontWeight: FontWeight.w600)),
                      ],
                    ),
                  );
                },
              ),
            ),
            const SizedBox(height: 16),
            SecretCard(
              secret: Secret(
                id: 'follow_sec_1',
                creatorId: 'mock_c1',
                creatorName: 'DanLevi',
                creatorTierLevel: 4,
                creatorTierColor: '#67E8F9',
                type: 'voice',
                audioDuration: 28,
                likes: 88,
                commentCount: 15,
                lat: 32.0853,
                lng: 34.7818,
              ),
            ),
          ],
        ),
      ),
      bottomNavigationBar: _buildAppShellBottomNav(3, isHe),
    );
  }

  // --- SCREEN 9: NOTIFICATIONS SETTINGS ---
  Widget _buildNotificationsScreen(bool isHe) {
    return Scaffold(
      appBar: AppBar(
        title: Text(isHe ? 'התראות חכמות' : 'Smart Notifications', style: const TextStyle(fontWeight: FontWeight.bold, color: Colors.white)),
        backgroundColor: Colors.transparent,
        elevation: 0,
      ),
      body: _buildBackgroundContainer(
        child: ListView(
          padding: const EdgeInsets.all(16),
          children: [
            // Proximity notification alert card
            Container(
              padding: const EdgeInsets.all(16),
              decoration: BoxDecoration(
                color: HushColors.textAccent.withValues(alpha: 0.12),
                borderRadius: BorderRadius.circular(18),
                border: Border.all(color: HushColors.textAccent.withValues(alpha: 0.35)),
              ),
              child: Row(
                children: [
                  const CircleAvatar(
                    radius: 20,
                    backgroundColor: HushColors.textAccent,
                    child: Icon(Icons.notifications_active, color: Colors.black, size: 22),
                  ),
                  const SizedBox(width: 14),
                  Expanded(
                    child: Column(
                      crossAxisAlignment: CrossAxisAlignment.start,
                      children: [
                        Text(
                          isHe ? 'Hushhh • התראת קרבה' : 'Hushhh • Proximity Alert',
                          style: const TextStyle(fontWeight: FontWeight.bold, color: HushColors.textAccent, fontSize: 14),
                        ),
                        const SizedBox(height: 2),
                        Text(
                          isHe ? '@SonicMaster הטמין Hushhh 45 מטר ממך!' : '@SonicMaster planted a Hushhh 45m away!',
                          style: const TextStyle(color: Colors.white, fontSize: 13),
                        ),
                      ],
                    ),
                  ),
                ],
              ),
            ),
            const SizedBox(height: 24),
            SwitchListTile(
              title: Text(isHe ? 'הפעל התראות חכמות' : 'Enable Smart Notifications', style: const TextStyle(fontWeight: FontWeight.bold, color: Colors.white)),
              subtitle: Text(isHe ? 'קבל עדכונים אקוסטיים בזמן אמת' : 'Receive real-time acoustic updates', style: const TextStyle(color: HushColors.textSecondary)),
              activeThumbColor: HushColors.textAccent,
              value: true,
              onChanged: (_) {},
            ),
            const Divider(height: 32, color: HushColors.borderSubtle),
            SwitchListTile(
              title: Text(isHe ? 'Hushhh של יוצרים במעקב' : 'Hushhh from creators you follow', style: const TextStyle(color: Colors.white)),
              subtitle: Text(isHe ? 'התראה כשיוצר שאתה עוקב אחריו מטמין Hushhh' : 'Alert when a creator you follow plants a Hushhh', style: const TextStyle(color: HushColors.textSecondary)),
              activeThumbColor: HushColors.textAccent,
              value: true,
              onChanged: (_) {},
            ),
            SwitchListTile(
              title: Text(isHe ? 'פתיחת Hushhh קבוצתי' : 'Group Hushhh unlocks', style: const TextStyle(color: Colors.white)),
              subtitle: Text(isHe ? 'התראה כשמשתמש נוסף מתקרב לפתיחה' : 'Alert when another user arrives for group unlock', style: const TextStyle(color: HushColors.textSecondary)),
              activeThumbColor: HushColors.textAccent,
              value: true,
              onChanged: (_) {},
            ),
            SwitchListTile(
              title: Text(isHe ? 'התראות רדאר ורטט קרבה' : 'Radar & haptic proximity alerts', style: const TextStyle(color: Colors.white)),
              subtitle: Text(isHe ? 'רטט כשאתה חולף ליד Hushhh במרחב' : 'Vibrate when you pass near a Hushhh in space', style: const TextStyle(color: HushColors.textSecondary)),
              activeThumbColor: HushColors.textAccent,
              value: true,
              onChanged: (_) {},
            ),
          ],
        ),
      ),
      bottomNavigationBar: _buildAppShellBottomNav(4, isHe),
    );
  }
