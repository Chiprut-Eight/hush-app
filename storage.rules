rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    
    // Audio files: authenticated users can UPLOAD, but reads are blocked
    // (access is via signed URLs generated by Cloud Functions)
    match /audio/{allPaths=**} {
      allow write: if request.auth != null;
      allow read: if request.auth != null;
    }

    // Profile photos: one file per user at profile_photos/{uid}_{timestamp}.jpg.
    // Client resizes to 512px before upload.
    match /profile_photos/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && fileName.matches(request.auth.uid + '.*');
    }
    
    // General fallback: block everything by default
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
